# Ignore output of scraper
data.sqlite

# IDEs and AI assistants
/.aider*
/.idea
/.vscode*

# Ignore vim files:
*~
*.swp
*.swo

# Ignore patch files
*.patch
*.rej

# Used by direnv / dotenv library to load environment variables.
.env*

# temp files
,*
/tmp/

# Ignore Byebug command history file.
.byebug_history

# Claude Code's local per-project notes, settings, worktrees and scheduler lock
/CLAUDE.local.md
/.claude/*.local*
/.claude/worktrees/
/.claude/scheduled_tasks.*
